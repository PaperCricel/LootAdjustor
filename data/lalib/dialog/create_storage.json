{
  "type": "minecraft:confirmation",
  "title": {
    "text": "Create Loot Storage"
  },
  "body": [
    {
      "type": "minecraft:plain_message",
      "contents": [
        {
          "text": "ℹ ",
          "color": "#e8b764"
        },
        {
          "text": "Tips",
          "bold": true,
          "underlined": true,
          "hover_event": {
            "action": "show_text",
            "value": ["",{"color":"#e8b764","text":"◆ "},{"color":"gray","text":"","extra":[{"bold":true,"text":"Management Width\n"},"Containers will stack to the left if the width"]},"\n",{"color":"gray","text":"is exceeded.\n\n"},{"color":"#E8B764","text":"◆ "},{"color":"gray","text":"","extra":[{"bold":true,"text":"Management Center\n"},"The center is set to your current position"]},"\n",{"color":"gray","text":"upon creation. You can relocate the center\nby "},{"color":"#e8b764","text":"Loot Controller"},{"color":"gray","text":"."}]
          }
        }
      ]
    }
  ],
  "inputs": [
    {
      "type": "minecraft:text",
      "key": "id",
      "width": 100,
      "label": {
        "text": "Storage ID"
      },
      "max_length": 100
    },
    {
      "type": "minecraft:number_range",
      "key": "max_width",
      "label": {
        "text": "Management Width",
        "type": "text"
      },
      "start": 1,
      "end": 50,
      "step": 1,
      "initial": 20
    }
  ],
  "yes": {
    "label": "Confirm",
    "action": {
      "type": "dynamic/run_command",
      "template": "function lalib:api/create_storage {id:$(id),max_width:$(max_width)}"
    }
  },
  "no": {
    "label": "Cancel",
    "action": {
      "type": "show_dialog",
      "dialog": "lalib:menu"
    }
  }
}