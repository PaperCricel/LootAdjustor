{
  "type": "minecraft:confirmation",
  "title": {
    "text": "Load Management Area"
  },
  "inputs": [
    {
      "type": "minecraft:text",
      "key": "id",
      "width": 100,
      "label": {
        "text": "Storage ID"
      },
      "max_length": 100
    }
  ],
  "yes": {
    "label": "Confirm",
    "action": {
      "type": "dynamic/run_command",
      "template": "function lalib:api/load_management {id:$(id)}"
    }
  },
  "no": {
    "label": "Cancel",
    "action": {
      "type": "show_dialog",
      "dialog": "lalib:menu"
    }
  }
}